# Copy to .env and fill in. Never commit .env.

# Required: MongoDB connection string (local server or Atlas).
MONGODB_URI=mongodb://localhost:27017
# Database name. Collections: question_bank, topics, assessments.
DB_NAME=adaptive_diagnostic

# Optional: enables AI study plans. Without it, rule-based plans are used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional tuning (defaults shown).
# SEED_ON_STARTUP=false
# ASSESSMENT_TTL_MINUTES=120
# SE_TARGET=0.40
# MIN_QUESTIONS=6
# AI_TIMEOUT_SECONDS=20
# AI_MAX_RETRIES=1
# STUDY_PLAN_MAX_AI_ATTEMPTS=3
# RATE_LIMIT_CREATE_PER_MINUTE=30
# RATE_LIMIT_ANSWER_PER_MINUTE=300
# RATE_LIMIT_STUDY_PLAN_PER_MINUTE=6
# CORS_ORIGINS=http://localhost:5173
# LOG_LEVEL=INFO
